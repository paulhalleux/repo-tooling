{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@paulhalleux/oxfmt-config": "^0.1.0",
    "@paulhalleux/oxlint-config": "^0.1.0",
    "@paulhalleux/tsconfig": "^0.1.0",
    "@paulhalleux/tsdown-config": "^0.1.0",
    "@paulhalleux/vitest-config": "^0.1.0",
    "@types/react": "^19.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "react": "^19.0.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
