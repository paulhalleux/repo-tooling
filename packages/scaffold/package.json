{
  "name": "@paulhalleux/scaffold",
  "version": "0.1.0",
  "description": "Composable, prompt-driven project scaffolding engine.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "defu": "^6.1.7",
    "giget": "^3.3.1",
    "handlebars": "^4.7.9",
    "picomatch": "^4.0.5",
    "scule": "^1.3.0",
    "tinyexec": "^1.3.0",
    "validate-npm-package-name": "^8.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paulhalleux/repo-tooling.git",
    "directory": "packages/scaffold"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22"
  }
}
