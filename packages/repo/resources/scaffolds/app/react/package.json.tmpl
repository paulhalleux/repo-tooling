{
  "name": "{{packageName}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "dev": "vite",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@paulhalleux/oxfmt-config": "^0.1.0",
    "@paulhalleux/oxlint-config": "^0.1.0",
    "@paulhalleux/tsconfig": "^0.1.0",
    "@paulhalleux/vite-config": "^0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.0",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
