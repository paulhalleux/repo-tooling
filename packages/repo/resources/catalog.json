{
  "layers": {
    "base/package": {
      "source": "layers/base-package",
      "description": "package.json, README, and .gitignore."
    },
    "base/typescript": {
      "source": "layers/typescript",
      "description": "TypeScript configuration and typecheck script.",
      "variables": {
        "tsconfigPreset": "library"
      }
    },
    "registry/paulhalleux": {
      "source": "layers/registry-paulhalleux",
      "description": "Routes @paulhalleux packages to GitHub Packages."
    },
    "tooling/oxlint": {
      "source": "layers/tooling-oxlint",
      "description": "oxlint and oxfmt configuration."
    },
    "bundler/tsdown": {
      "source": "layers/bundler-tsdown",
      "description": "tsdown bundling and package entry points."
    },
    "bundler/vite": {
      "source": "layers/bundler-vite",
      "description": "Vite dev server, build, and HTML entry point."
    },
    "entry/typescript-library": {
      "source": "layers/library-typescript",
      "description": "TypeScript library entry point.",
      "files": [
        {
          "path": "src/**/*.test.ts",
          "when": "(includes features \"tests\")"
        }
      ]
    },
    "entry/react-library": {
      "source": "layers/library-react",
      "description": "React library entry point and peer dependencies.",
      "variables": {
        "tsconfigPreset": "react"
      }
    },
    "entry/react-app": {
      "source": "layers/app-react",
      "description": "React application shell.",
      "variables": {
        "tsconfigPreset": "react"
      }
    },
    "testing/vitest": {
      "source": "layers/testing-vitest",
      "description": "Vitest setup.",
      "prompts": [
        {
          "type": "confirm",
          "name": "coverage",
          "message": "Add coverage reporting?",
          "default": false
        }
      ]
    },
    "publish/github-packages": {
      "source": "layers/publish-github-packages",
      "description": "Publish configuration for GitHub Packages."
    },
    "workspace/pnpm": {
      "source": "layers/workspace-pnpm",
      "description": "pnpm workspace configuration and recursive scripts."
    },
    "workspace/changesets": {
      "source": "layers/workspace-changesets",
      "description": "Changesets configuration and release scripts."
    },
    "repo/github-ci": {
      "source": "layers/repo-github-ci",
      "description": "Shared CI workflow calling the reusable node-ci workflow.",
      "managed": true
    },
    "ai/skills": {
      "source": "ai/skills",
      "target": ".agents/skills",
      "description": "Project-scoped agent skills.",
      "managed": true,
      "prompts": [
        {
